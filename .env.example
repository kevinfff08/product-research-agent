# LLM_MODE controls authentication style:
# - setup-token: route through CLIProxyAPI at LLM_PROXY_URL.
# - api-key: call the provider endpoint directly with the provider API key.
LLM_MODE=setup-token

# Supported providers: openai, deepseek, google.
# In setup-token mode this is metadata/default-model selection; CLIProxyAPI still
# decides which models are actually available.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4
DEEPSEEK_MODEL=
GOOGLE_MODEL=

# CLIProxyAPI endpoint. The client normalizes this to /v1 internally.
LLM_PROXY_URL=http://localhost:8317

# Optional launcher overrides used by start.bat/start.sh.
CLIPROXYAPI_EXE=
CLIPROXYAPI_CONFIG=
CLIPROXYAPI_CMD=

# Direct provider mode keys and optional custom OpenAI-compatible base URLs.
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Generic fallback for custom OpenAI-compatible endpoints in api-key mode.
LLM_API_KEY=
LLM_BASE_URL=

# Recommended for product, academic-web, code-web, and community search.
TAVILY_API_KEY=
