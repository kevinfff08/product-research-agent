# ============================================================
# Product Research Agent — 环境配置
# 复制此文件为 .env 并填入你的密钥即可使用
#   cp .env.example .env
# ============================================================

# 认证模式: api-key（直连） / setup-token（通过 CLIProxyAPI）
LLM_MODE=api-key

# LLM 提供商: openai / deepseek / google
LLM_PROVIDER=deepseek

# 模型名称，不填则使用各提供商的默认模型：
#   openai   → gpt-5.4
#   deepseek → deepseek-v4-flash
#   google   → gemini-2.5-flash
LLM_MODEL=

# CLIProxyAPI 地址（仅 setup-token 模式需要，默认 http://localhost:8317）
# LLM_PROXY_URL=http://localhost:8317

# API 密钥 — 只填你要用的那个提供商
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# 可选：自定义 API 地址，不填则使用默认地址：
#   openai   → https://api.openai.com/v1
#   deepseek → https://api.deepseek.com
#   google   → https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_BASE_URL=
# DEEPSEEK_BASE_URL=
# GOOGLE_BASE_URL=

# 网页搜索密钥（必填，注册地址：tavily.com）
TAVILY_API_KEY=
