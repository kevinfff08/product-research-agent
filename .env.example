# LLM_MODE=setup-token uses CLIProxyAPI. LLM_MODE=api-key uses OPENAI_API_KEY.
LLM_MODE=setup-token

# Use a model that is exposed by your proxy or OpenAI-compatible account.
LLM_MODEL=gpt-5.4

# CLIProxyAPI endpoint. The client normalizes this to /v1 internally.
LLM_PROXY_URL=http://localhost:8317

# Optional launcher overrides used by start.bat/start.sh.
CLIPROXYAPI_EXE=
CLIPROXYAPI_CONFIG=
CLIPROXYAPI_CMD=

# Required only when LLM_MODE=api-key.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Required for industry web search.
TAVILY_API_KEY=

# Optional higher-rate-limit keys.
SEMANTIC_SCHOLAR_API_KEY=
GITHUB_TOKEN=
